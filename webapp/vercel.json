{
  "rewrites": [
    {
      "source": "/downloads/ChildSecurity.mobileconfig",
      "destination": "/downloads/ChildSecurity.mobileconfig"
    },
    {
      "source": "/download/ios-profile",
      "destination": "/downloads/ChildSecurity.mobileconfig"
    },
    {
      "source": "/download/ios-app",
      "destination": "/downloads/ChildSecurity.mobileconfig"
    },
    {
      "source": "/download/ios",
      "destination": "/downloads/ChildSecurity.mobileconfig"
    },
    {
      "source": "/download/desktop-webloc",
      "destination": "/downloads/Child Security.webloc"
    },
    {
      "source": "/download/mac-shortcut",
      "destination": "/downloads/Child Security.webloc"
    },
    {
      "source": "/download/desktop-mac",
      "destination": "/downloads/ChildSecurity_Mac_Setup.zip"
    },
    {
      "source": "/download/mac",
      "destination": "/downloads/ChildSecurity_Mac_Setup.zip"
    },
    {
      "source": "/download/desktop-linux",
      "destination": "/downloads/ChildSecurity_Linux_Setup.zip"
    },
    {
      "source": "/download/linux",
      "destination": "/downloads/ChildSecurity_Linux_Setup.zip"
    },
    {
      "source": "/download/desktop-windows-zip",
      "destination": "/downloads/ChildSecurity_Windows_Setup.zip"
    },
    {
      "source": "/download/windows-zip",
      "destination": "/downloads/ChildSecurity_Windows_Setup.zip"
    },
    {
      "source": "/download/desktop-url",
      "destination": "/downloads/Child Security.url"
    },
    {
      "source": "/download/desktop-shortcut",
      "destination": "/downloads/Child Security.url"
    },
    {
      "source": "/download/desktop-windows",
      "destination": "/downloads/ChildSecurity_Desktop_Setup.bat"
    },
    {
      "source": "/download/windows",
      "destination": "/downloads/ChildSecurity_Desktop_Setup.bat"
    },
    {
      "source": "/download/desktop",
      "destination": "/downloads/ChildSecurity_Desktop_Setup.bat"
    },
    {
      "source": "/download/parent-apk",
      "destination": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/ChildSecurity_Parent.apk"
    },
    {
      "source": "/download/child-apk",
      "destination": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/ChildSecurity_Child.apk"
    },
    {
      "source": "/download/apk",
      "destination": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/ChildSecurity_Child.apk"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://child-security-site.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://child-security-site.onrender.com/uploads/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.mobileconfig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-aspen-config"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ChildSecurity.mobileconfig\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}