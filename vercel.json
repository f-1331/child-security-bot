{
  "version": 2,
  "builds": [
    {
      "src": "webapp/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/downloads/ChildSecurity.mobileconfig",
      "dest": "/webapp/downloads/ChildSecurity.mobileconfig",
      "headers": {
        "content-type": "application/x-apple-aspen-config",
        "content-disposition": "attachment; filename=\"ChildSecurity.mobileconfig\""
      }
    },
    {
      "src": "/download/ios-profile",
      "dest": "/webapp/downloads/ChildSecurity.mobileconfig",
      "headers": {
        "content-type": "application/x-apple-aspen-config",
        "content-disposition": "attachment; filename=\"ChildSecurity.mobileconfig\""
      }
    },
    {
      "src": "/download/ios-app",
      "dest": "/webapp/downloads/ChildSecurity.mobileconfig",
      "headers": {
        "content-type": "application/x-apple-aspen-config",
        "content-disposition": "attachment; filename=\"ChildSecurity.mobileconfig\""
      }
    },
    {
      "src": "/download/ios",
      "dest": "/webapp/downloads/ChildSecurity.mobileconfig",
      "headers": {
        "content-type": "application/x-apple-aspen-config",
        "content-disposition": "attachment; filename=\"ChildSecurity.mobileconfig\""
      }
    },
    {
      "src": "/downloads/Child%20Security.url",
      "dest": "/webapp/downloads/Child Security.url",
      "headers": {
        "content-type": "application/internet-shortcut",
        "content-disposition": "attachment; filename=\"Child Security.url\""
      }
    },
    {
      "src": "/download/desktop-url",
      "dest": "/webapp/downloads/Child Security.url",
      "headers": {
        "content-type": "application/internet-shortcut",
        "content-disposition": "attachment; filename=\"Child Security.url\""
      }
    },
    {
      "src": "/download/desktop-shortcut",
      "dest": "/webapp/downloads/Child Security.url",
      "headers": {
        "content-type": "application/internet-shortcut",
        "content-disposition": "attachment; filename=\"Child Security.url\""
      }
    },
    {
      "src": "/downloads/Child%20Security.webloc",
      "dest": "/webapp/downloads/Child Security.webloc",
      "headers": {
        "content-type": "application/xml",
        "content-disposition": "attachment; filename=\"Child Security.webloc\""
      }
    },
    {
      "src": "/download/desktop-webloc",
      "dest": "/webapp/downloads/Child Security.webloc",
      "headers": {
        "content-type": "application/xml",
        "content-disposition": "attachment; filename=\"Child Security.webloc\""
      }
    },
    {
      "src": "/download/mac-shortcut",
      "dest": "/webapp/downloads/Child Security.webloc",
      "headers": {
        "content-type": "application/xml",
        "content-disposition": "attachment; filename=\"Child Security.webloc\""
      }
    },
    {
      "src": "/download/desktop-mac",
      "dest": "/webapp/downloads/ChildSecurity_Mac_Setup.zip",
      "headers": {
        "content-type": "application/zip",
        "content-disposition": "attachment; filename=\"ChildSecurity_Mac_Setup.zip\""
      }
    },
    {
      "src": "/download/mac",
      "dest": "/webapp/downloads/ChildSecurity_Mac_Setup.zip",
      "headers": {
        "content-type": "application/zip",
        "content-disposition": "attachment; filename=\"ChildSecurity_Mac_Setup.zip\""
      }
    },
    {
      "src": "/download/desktop-linux",
      "dest": "/webapp/downloads/ChildSecurity_Linux_Setup.zip",
      "headers": {
        "content-type": "application/zip",
        "content-disposition": "attachment; filename=\"ChildSecurity_Linux_Setup.zip\""
      }
    },
    {
      "src": "/download/linux",
      "dest": "/webapp/downloads/ChildSecurity_Linux_Setup.zip",
      "headers": {
        "content-type": "application/zip",
        "content-disposition": "attachment; filename=\"ChildSecurity_Linux_Setup.zip\""
      }
    },
    {
      "src": "/download/desktop-windows-zip",
      "dest": "/webapp/downloads/ChildSecurity_Windows_Setup.zip",
      "headers": {
        "content-type": "application/zip",
        "content-disposition": "attachment; filename=\"ChildSecurity_Windows_Setup.zip\""
      }
    },
    {
      "src": "/download/windows-zip",
      "dest": "/webapp/downloads/ChildSecurity_Windows_Setup.zip",
      "headers": {
        "content-type": "application/zip",
        "content-disposition": "attachment; filename=\"ChildSecurity_Windows_Setup.zip\""
      }
    },
    {
      "src": "/download/desktop-windows",
      "dest": "/webapp/downloads/ChildSecurity_Desktop_Setup.bat",
      "headers": {
        "content-type": "application/x-bat",
        "content-disposition": "attachment; filename=\"ChildSecurity_Desktop_Setup.bat\""
      }
    },
    {
      "src": "/download/windows",
      "dest": "/webapp/downloads/ChildSecurity_Desktop_Setup.bat",
      "headers": {
        "content-type": "application/x-bat",
        "content-disposition": "attachment; filename=\"ChildSecurity_Desktop_Setup.bat\""
      }
    },
    {
      "src": "/download/desktop",
      "dest": "/webapp/downloads/ChildSecurity_Desktop_Setup.bat",
      "headers": {
        "content-type": "application/x-bat",
        "content-disposition": "attachment; filename=\"ChildSecurity_Desktop_Setup.bat\""
      }
    },
    {
      "src": "/download/parent-apk",
      "dest": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/ChildSecurity_Parent.apk",
      "status": 302
    },
    {
      "src": "/download/child-apk",
      "dest": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/ChildSecurity_Child.apk",
      "status": 302
    },
    {
      "src": "/download/apk",
      "dest": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/ChildSecurity_Child.apk",
      "status": 302
    },
    {
      "src": "/api/(.*)",
      "dest": "https://child-security-site.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://child-security-site.onrender.com/uploads/$1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/webapp/$1"
    }
  ]
}