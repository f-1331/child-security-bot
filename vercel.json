{
  "version": 2,
  "builds": [
    {
      "src": "webapp/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/download/parent-apk",
      "dest": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/app-debug.apk",
      "status": 302
    },
    {
      "src": "/download/child-apk",
      "dest": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/app-debug.apk",
      "status": 302
    },
    {
      "src": "/download/apk",
      "dest": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/app-debug.apk",
      "status": 302
    },
    {
      "src": "/download/(.*)",
      "dest": "https://github.com/f-1331/child-security-bot/releases/download/v1.0.0-apk/app-debug.apk",
      "status": 302
    },
    {
      "src": "/api/(.*)",
      "dest": "https://child-security-site.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://child-security-site.onrender.com/uploads/$1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/webapp/$1"
    }
  ]
}