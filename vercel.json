{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://child-security-site.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://child-security-site.onrender.com/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/webapp/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
